{
  "expo": {
    "name": "Motif Capture",
    "slug": "motif-capture",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.motif.capture",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Motif discovers Bridge and syncs your ideas over your local network.",
        "NSBonjourServices": [
          "_motif-bridge._tcp",
          "_motif-bridge._tcp"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.motif.capture",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      "expo-sharing",
      "@siteed/audio-studio",
      "expo-background-task",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Motif tags your recordings with where you made them when you turn on location tagging."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6782d888-1652-468a-8a91-b49de982d905"
      }
    },
    "owner": "andersdigital"
  }
}
